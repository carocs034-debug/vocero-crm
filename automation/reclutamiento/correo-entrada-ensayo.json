{
  "name": "Talented - Ensayo controlado en Entrada",
  "nodes": [
    {
      "name": "Correo de prueba",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "format": "resolved",
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "trackLastMessageId": true,
          "customEmailConfig": "[[\"HEADER\",\"SUBJECT\",\"Talented - Ensayo Entrada\"]]"
        }
      },
      "id": "nodo-01"
    },
    {
      "name": "Procesar cada correo",
      "id": "correo-procesar-cada-uno",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "TldEntradaMensaje"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Correo de prueba": {
      "main": [
        [
          {
            "node": "Procesar cada correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false
  },
  "active": false
}
